generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  name          String?
  image         String?
  passwordHash  String?       @map("password_hash")
  emailVerified DateTime?     @map("email_verified")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  accounts      Account[]
  reservations  Reservation[]
  sessions      Session[]
  wishlists     Wishlist[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Wishlist {
  id                   String        @id @default(cuid())
  userId               String        @map("user_id")
  title                String        @db.VarChar(100)
  description          String?       @db.VarChar(500)
  coverImage           String?       @map("cover_image")
  occasion             OccasionType?
  visibility           Visibility    @default(private)
  shareToken           String        @unique @map("share_token") @db.VarChar(64)
  showReserverIdentity Boolean       @default(false) @map("show_reserver_identity")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  items                GiftItem[]
  owner                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shareToken])
  @@index([visibility])
  @@map("wishlists")
}

model GiftItem {
  id          String       @id @default(cuid())
  wishlistId  String       @map("wishlist_id")
  title       String       @db.VarChar(150)
  description String?      @db.VarChar(1000)
  price       Decimal?     @db.Decimal(11, 2)
  url         String?
  imageUrl    String?      @map("image_url")
  priority    Priority?
  notes       String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  wishlist    Wishlist     @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  reservation Reservation?

  @@index([wishlistId])
  @@map("gift_items")
}

model Reservation {
  id         String   @id @default(cuid())
  giftItemId String   @unique @map("gift_item_id")

  userId     String?  @map("user_id")
  
  guestName  String?  @map("guest_name")
  guestEmail String?  @map("guest_email")
  guestPhone String?  @map("guest_phone")
  notes      String?  @db.VarChar(500)

  message    String?  @db.VarChar(1000)

  createdAt  DateTime @default(now()) @map("created_at")
  giftItem   GiftItem @relation(fields: [giftItemId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("reservations")
}

enum Visibility {
  public
  private
  link_only
}

enum OccasionType {
  birthday
  wedding
  holiday
  other
}

enum Priority {
  low
  medium
  high
}
